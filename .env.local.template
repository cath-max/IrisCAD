VITE_SUPABASE_ANON_KEY="<Test Anon Key>"
VITE_SUPABASE_URL='http://127.0.0.1:54321'
# Canonical production browser origin. Leave unset locally to use localhost.
# VITE_APP_URL="https://iriscad.com"
SUPABASE_SERVICE_ROLE_KEY="<Test Service Role Key>"
# Optional: SSO-only mode. Set to any Supabase OAuth provider slug — e.g.
# 'custom:my-idp' for a custom OIDC provider configured in your Supabase
# dashboard — and the app root becomes the only auth surface: its signed-out
# UI is unchanged, but the sign-in/sign-up affordances redirect to the
# provider, /signin & /signup & /signup-email bounce to root, and
# unauthenticated deep links redirect straight to the provider. Leave unset
# to keep the native auth UI (the local Supabase CLI stack can't host
# custom OIDC providers).
# VITE_SSO_PROVIDER="custom:my-idp"
# Optional: when SSO owns the identity, point profile / password / delete
# management at the provider's account page (the accounts.google.com model)
# instead of editing them in-app. Unset keeps the native in-app controls.
# VITE_ACCOUNT_URL="https://accounts.example.com/account"
VITE_POSTHOG_PROJECT_KEY="<Test PostHog Project Key>"
VITE_SENTRY_ENVIRONMENT="local"
VITE_SENTRY_DSN="<Sentry DSN>"
ANTHROPIC_API_KEY="<Test Anthropic API Key>"
# Hybrid SimpleCADAPI retrieval. These values are read by `npm run sidecar`
# and `npm run dev:local` from this same file.
EMBEDDING_API_KEY="<Your embedding API key>"
EMBEDDING_BASE_URL="https://api.openai.com/v1"
EMBEDDING_MODEL="text-embedding-3-small"
# Optional ZenMux Anthropic-compatible base (Claude). Example:
# ANTHROPIC_BASE_URL="https://zenmux.ai/api/anthropic"
# ZenMux OpenAI-compatible gateway for Grok / Kimi / other non-allowlisted models.
# ZENMUX_OPENAI_BASE_URL="https://zenmux.ai/api/v1"
# ZENMUX_API_KEY="<same ZenMux key as ANTHROPIC_API_KEY; optional if ANTHROPIC_API_KEY works>"
# Real OpenRouter — only GPT Sol / Gemini 3.1 Pro / GLM 5.2 are routed here
# (multimodal tool images). Required if you select those three models.
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_API_KEY="<Test OpenRouter API Key>"
GOOGLE_API_KEY="<Test Google API Key>"
BILLING_SERVICE_URL="<Test Billing Service URL>"
BILLING_SERVICE_KEY="<Test Billing Service Key>"
ENVIRONMENT="local"
# Local development uses the API keys above directly and does not consume
# Iris Credits. Production explicitly overrides this to true in cloudbuild.
IRIS_CREDITS_ENABLED="false"
# Public application origin used for server-generated redirects. Local requests
# fall back to their own origin when this is unset.
APP_URL="http://localhost:3000"
# Shared bearer secret for the internal server-to-server account-purge endpoint
# (POST /api/internal/account/delete). The upstream identity provider's purge
# worker presents this to erase a user's data here when their account is
# deleted. Leave unset to hard-disable the endpoint (it 503s every request).
# Provider-agnostic: any deployment sets its own value.
ACCOUNT_PURGE_SECRET="<Shared account-purge secret>"
# SimpleCADAPI API retrieval sidecar (parametric chat). Requires
# `python scripts/serve_api_retrieval.py` in SimpleCADAPI-repo.
# MODE=sidecar (default) | full_index (legacy whole agent-api-index.md)
# API_RETRIEVAL_MODE="sidecar"
# API_RETRIEVAL_URL="http://127.0.0.1:8765"
# API_RETRIEVAL_TIMEOUT_MS="2500"
# Optional fast model for the non-first-turn local-edit target router.
# Unset uses the user's selected chat model. Example:
# LOCAL_EDIT_ROUTER_MODEL_ID="anthropic/claude-haiku-4.5"
# Plan C A/B: Gemini feature summary before codegen (images still attached either way).
# true (default) = summary + images; false = images + text only (skip Gemini summary).
VISION_FEATURE_SUMMARY="true"
